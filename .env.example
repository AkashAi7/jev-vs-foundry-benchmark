TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Copy the account inference endpoint and deployment name from Foundry Toolkit.
# This is NOT the project URL ending in /api/projects/...
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
# Explicit identity choice. Never falls back to a different identity or an API key.
FOUNDRY_AUTH_MODE=service-principal
# Required in service-principal mode. Preserve existing environment values.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# Optional approved developer route: set FOUNDRY_AUTH_MODE=vscode and AZURE_TENANT_ID
# to the resource tenant, then sign in via the Azure Resources extension.
# This uses an Entra user, not the service principal. Restart the server to apply.
PORT=4317
